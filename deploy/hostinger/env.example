# Copy to .env.hostinger in the repository root on the server.
# Replace SECRET_KEY before starting. Do not commit the real environment file.
APP_NAME=Prarit Sidana PDF
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET
FILE_TTL_SECONDS=7200
MAX_FILE_MB=100
MAX_REQUEST_MB=64
WORKERS=2
MAX_QUEUED_TASKS=8
TASK_TIMEOUT_SECONDS=900
TASKS_PER_HOUR=20
ALLOW_PRIVATE_URLS=0
# Enable only once a local trusted proxy overwrites forwarded client-IP headers.
TRUST_PROXY=0

# Confirm free ports/resources on the server before deployment.
# Keep loopback binding when using a reverse proxy for the domain.
PDFNOVA_BIND_ADDRESS=127.0.0.1
PDFNOVA_PORT=8086
PDFNOVA_CPUS=1.5
PDFNOVA_MEMORY_LIMIT=2g

# Canonical public origin; never derive SEO URLs from an incoming Host header.
SITE_URL=https://pdf.praritsidana.com
# Optional webmaster verification tokens (token values only).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Public IndexNow ownership key; set once before using submit_indexnow.py.
INDEXNOW_KEY=
