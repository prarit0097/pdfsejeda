# Local settings — copy to .env and set SECRET_KEY. Docker compose reads this file too.
APP_NAME=PDFNova
SECRET_KEY=change-me-to-a-long-random-string
TASKS_PER_HOUR=0
MAX_FILE_MB=200
WORKERS=4
MAX_QUEUED_TASKS=32
TASK_TIMEOUT_SECONDS=900
MAX_REQUEST_MB=64
FILE_TTL_SECONDS=7200
# Enable only behind a trusted proxy that overwrites forwarded client-IP headers.
TRUST_PROXY=0
# Leave disabled for public installations.
ALLOW_PRIVATE_URLS=0
